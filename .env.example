# ============================================================
#  MUN Crisis - environment variables
#  Copy this file to `.env` (same folder) and fill in the values.
#  One .env at the repo root is shared by the server and the web app.
# ============================================================

# ---------- Database (Neon Postgres, via Drizzle ORM) ----------
# Neon Console -> your project -> Connect -> copy the connection string (keep ?sslmode=require)
#   e.g. postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional local fallback (`npm run db:up`): postgresql://mun:mun@localhost:5433/mun_crisis
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- Clerk authentication (REQUIRED) ----------
# Clerk Dashboard -> your application -> Configure -> API keys
# Publishable key starts with pk_test_ / pk_live_, secret key with sk_test_ / sk_live_
CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"
CLERK_SECRET_KEY="your-clerk-secret-key"
# Must be the SAME value as CLERK_PUBLISHABLE_KEY (Vite only exposes VITE_* vars to the browser)
VITE_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"

# ---------- Server ----------
# Port for the API + socket server (platforms that inject PORT, e.g. Render/Railway, also work)
SERVER_PORT=4000
# Comma-separated list of origins allowed to call the API / open sockets
CLIENT_ORIGIN="http://localhost:5173"
# Comma-separated emails that get access to the /admin panel
ADMIN_EMAILS="you@example.com"
# A finished game only counts toward the global leaderboard with at least this many players
MIN_PLAYERS_FOR_RANKED=3

# ---------- AI coaching card (OPTIONAL) ----------
# Leave empty to use the built-in rule-based coaching instead.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ---------- Web app ----------
# Leave empty in development (Vite proxies /api and /socket.io to the server).
# Set only if the web app is hosted on a different domain than the server.
VITE_API_URL=""
